# Environment Variables for the Backend
# -----------------------------------------------
# Copy this file to ".env" and fill in your values.
# The ".env" file must NEVER be committed to Git.

# MongoDB connection string.
# Local:  mongodb://localhost:27017/urlshortener
# Atlas:  mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/urlshortener
MONGO_URI=mongodb://localhost:27017/urlshortener

# The port the Express server will listen on
PORT=5000

# The base URL of this backend — used to build the short link
# e.g.  http://localhost:5000/r/k7mXp2
BASE_URL=http://localhost:5000
